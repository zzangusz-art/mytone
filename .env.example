# 이 파일을 .env 로 복사해서 쓰세요. (.env 는 깃에 올리지 않습니다)

# ── 글쓰기 엔진 ──────────────────────────────────────────────
# 키가 있으면 Claude 로 실제 글쓰기, 없으면 데모 모드로 동작합니다.
# 키는 반드시 서버(이 파일 또는 호스팅의 환경변수)에만 둡니다. 화면(브라우저)에는 내려가지 않습니다.
ANTHROPIC_API_KEY=
# MYTONE_LLM=auto                 # auto | claude | demo
# MYTONE_CLAUDE_MODEL=claude-opus-5-5
# MYTONE_CLAUDE_EFFORT=medium     # low | medium | high (높일수록 느리고 비쌉니다)
# MYTONE_CLAUDE_FALLBACKS=default # default | off  (모델이 요청을 거절하면 대체 모델로 다시 시도)

# ── 음성 인식(STT) ───────────────────────────────────────────
# WHISPER_MODEL=ggml-large-v3-turbo-q5_0.bin
# MODELS_DIR=                     # 기본: %LOCALAPPDATA%\MyTone\models
# WHISPER_USE_GPU=1
# KEEP_AUDIO=0                    # 1 이면 전사 후에도 원본 음성을 지우지 않습니다(권장하지 않음)
# MAX_UPLOAD_MB=200

# ── 서버 ─────────────────────────────────────────────────────
# HOST=127.0.0.1                  # 다른 PC에서도 접속하게 하려면 0.0.0.0 (반드시 INVITE_CODE 와 HTTPS 를 함께)
# PORT=8700
# DATA_DIR=                       # 기본: 이 폴더의 data/
# INVITE_CODE=                    # 설정하면 가입할 때 이 코드를 넣어야 합니다(아무나 가입 방지)
# SECRET_KEY=                     # 비우면 data/.secret_key 에 자동 생성
# ALLOWED_ORIGINS=                # 화면을 다른 도메인에서 띄울 때만(쉼표 구분)
